{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chromaweb-intake",
  "main": "src/worker.js",
  // Match the workerd runtime pinned by the Wrangler lockfile.
  "compatibility_date": "2026-11-19",
  "send_metrics": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chromaweb-intake",
      "database_id": "070e3ab3-6a70-4a0a-a8b1-b01c26e8c156"
    }
  ],
  "env": {
    "preview": {
      "name": "chromaweb-intake-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chromaweb-intake-preview",
          "database_id": "6a070329-6e92-454e-9b6e-23d560e0a8ea"
        }
      ]
    }
  }
}
